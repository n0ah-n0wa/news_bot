# Telegram API Configuration
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username

# News Bot Account ID
# This is the user ID of the account that will send messages to your bot
TELEGRAM_NEWS_BOT_ID=your_news_bot_account_id

# User Chat IDs (comma-separated)
# Get your user ID from @userinfobot on Telegram
TELEGRAM_USER_CHAT_IDS=user_id_1,user_id_2,user_id_3

# Channels to Monitor (comma-separated)
# Public usernames (@channel) or numeric IDs with the -100 prefix (-1001234567890)
# Get numeric IDs using @getidsbot or by forwarding a message from the channel
TELEGRAM_CHANNEL_IDS=channel_id_1,channel_id_2,channel_id_3

# Telethon session file path (".session" is appended automatically)
TELEGRAM_SESSION_PATH=sessions/news_bot_session

# OpenAI Configuration
# Get API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.0

# Rate Limiting Configuration
MAX_TOKENS_PER_MINUTE=40000
MAX_REQUESTS_PER_MINUTE=3
MAX_REQUESTS_PER_DAY=200

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/news_bot.log
